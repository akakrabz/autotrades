# Copy to .env (git-ignored). Everything here is a secret or a personal identifier.

# Telegram: create a bot with @BotFather, then get your numeric chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_OWNER_ID=123456789

# SEC EDGAR fair-access policy requires "<app> <contact email>" (www.sec.gov returns 403 otherwise).
SEC_USER_AGENT=autotrades you@example.com

# Optional: raises OpenFIGI CUSIP->ticker lookups from 10/request to 100/request.
# OPENFIGI_API_KEY=

# Only needed when [news].enabled = true.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: log filter (default "info,ibapi=warn").
# RUST_LOG=info,autotrades::engine=debug
